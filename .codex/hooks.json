{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import subprocess,sys,runpy; r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.path.insert(0,r+'/tools'); sys.argv=['slack_hook.py','codex']; runpy.run_path(r+'/tools/slack_hook.py',run_name='__main__')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import subprocess,sys,runpy; r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.path.insert(0,r+'/tools'); sys.argv=['slack_hook.py','codex']; runpy.run_path(r+'/tools/slack_hook.py',run_name='__main__')\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import subprocess,sys,runpy; r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.path.insert(0,r+'/tools'); sys.argv=['slack_hook.py','codex']; runpy.run_path(r+'/tools/slack_hook.py',run_name='__main__')\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
