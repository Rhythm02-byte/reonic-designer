{
  "name": "thinc",
  "private": true,
  "description": "thinc! x Reonic monorepo. Use pnpm: bootstrap, dev, test, eval (see README).",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "cd services/engine && node ../../scripts/py.mjs -m pytest -q && cd ../.. && node scripts/py.mjs -m pytest -q eval && pnpm --dir apps/web lint && pnpm --dir apps/web exec tsc --noEmit",
    "eval": "node scripts/py.mjs eval/run.py --data dataset --offline",
    "x:etl": "node scripts/py.mjs -m engine.etl.normalize --raw dataset --out data/processed",
    "x:train": "node scripts/py.mjs -m engine.policy.train",
    "x:select": "node scripts/py.mjs eval/run.py --data dataset --offline --select",
    "x:contracts": "pnpm --dir packages/contracts build",
    "x:web-build": "pnpm --dir apps/web build",
    "x:correlations": "node scripts/py.mjs research/data_correlations.py",
    "x:external": "node scripts/py.mjs eval/external/benchmark.py",
    "x:research": "node scripts/py.mjs eval/research.py"
  }
}
